 *
 * Ryujinx-style dark theme: a #202020 menu and toolbar band over a #2d2d2d content area, games as
 * #393939 cards, and a #4ca2ff accent.
 */

QWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    selection-background-color: #4ca2ff;
    selection-color: #ffffff;
    font-size: 14px;
}

QWidget:disabled {
    color: #7a7a7a;
}

QMainWindow, QDialog {
    background-color: #2d2d2d;
}

QMainWindow::separator {
    background-color: #202020;
    width: 1px;
    height: 1px;
}

QToolTip {
    background-color: #393939;
    color: #ffffff;
    border: 1px solid #505050;
    padding: 4px;
}

/* Menus ------------------------------------------------------------------------------------- */

QMenuBar {
    background-color: #202020;
    border: none;
    padding: 4px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #393939;
}

QMenu {
    background-color: #2b2b2b;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3d3d3d;
}

QMenu::item:disabled {
    color: #7a7a7a;
}

QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

QMenu::indicator:checked {
    image: url(:/qss_icons/rc/checkbox_checked.png);
}

QMenu::indicator:unchecked {
    image: url(:/qss_icons/rc/checkbox_unchecked.png);
}

/* Ryujinx toolbar (list/grid toggles, icon size, sort, search) ------------------------------ */

QWidget#RyujinxToolbar {
    background-color: #202020;
}

QWidget#RyujinxToolbar QToolButton {
    background-color: #2d2d2d;
    border: 1px solid #2d2d2d;
    border-radius: 4px;
    padding: 6px;
    min-width: 24px;
    min-height: 24px;
}

QWidget#RyujinxToolbar QToolButton:hover {
    background-color: #393939;
}

QWidget#RyujinxToolbar QToolButton:checked {
    background-color: #393939;
    border: 1px solid #393939;
}

QWidget#RyujinxToolbar QLineEdit, QWidget#RyujinxToolbar QComboBox {
    background-color: #2d2d2d;
    border: 1px solid #2d2d2d;
    border-bottom: 1px solid #505050;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 20px;
}

QWidget#RyujinxToolbar QLineEdit:focus {
    border-bottom: 2px solid #4ca2ff;
}

/* Buttons ----------------------------------------------------------------------------------- */

QPushButton, QToolButton {
    background-color: #393939;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 5px 14px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #454545;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #2b2b2b;
}

QPushButton:default {
    background-color: #4ca2ff;
    border: 1px solid #4ca2ff;
    color: #000000;
}

QPushButton:default:hover {
    background-color: #6ab2ff;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #303030;
    color: #6a6a6a;
    border: 1px solid #3a3a3a;
}

QPushButton:checked {
    background-color: #2f4a66;
    border: 1px solid #4ca2ff;
}

/* Inputs ------------------------------------------------------------------------------------ */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QKeySequenceEdit {
    background-color: #252525;
    color: #ffffff;
    border: 1px solid #454545;
    border-bottom: 1px solid #6a6a6a;
    border-radius: 4px;
    padding: 4px 6px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-bottom: 2px solid #4ca2ff;
}

QComboBox {
    background-color: #393939;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 26px 4px 8px;
    min-height: 18px;
}

QComboBox:hover {
    background-color: #454545;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/qss_icons/rc/down_arrow.png);
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    border: 1px solid #454545;
    selection-background-color: #3d3d3d;
    outline: 0;
}

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/qss_icons/rc/checkbox_unchecked.png);
}

QCheckBox::indicator:checked {
    image: url(:/qss_icons/rc/checkbox_checked.png);
}

QCheckBox::indicator:indeterminate {
    image: url(:/qss_icons/rc/checkbox_indeterminate.png);
}

QRadioButton::indicator:unchecked {
    image: url(:/qss_icons/rc/radio_unchecked.png);
}

QRadioButton::indicator:checked {
    image: url(:/qss_icons/rc/radio_checked.png);
}

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #9a9a9a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #4ca2ff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #4ca2ff;
    border: 4px solid #393939;
    width: 12px;
    height: 12px;
    margin: -8px 0;
    border-radius: 10px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #9a9a9a;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background-color: #4ca2ff;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #4ca2ff;
    border: 4px solid #393939;
    width: 12px;
    height: 12px;
    margin: 0 -8px;
    border-radius: 10px;
}

QProgressBar {
    background-color: #393939;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #4ca2ff;
    border-radius: 4px;
}

/* Lists, the game list --------------------------------------------------------------------- */

QAbstractItemView {
    background-color: #2d2d2d;
    alternate-background-color: #2d2d2d;
    border: none;
    outline: 0;
}

QTreeView::item, QListView::item {
    padding: 2px;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #353535;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #3d3d3d;
    color: #ffffff;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/qss_icons/rc/branch_closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/qss_icons/rc/branch_open.png);
}

QHeaderView {
    background-color: #2d2d2d;
    border: none;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #c8c8c8;
    border: none;
    border-bottom: 1px solid #454545;
    padding: 6px 8px;
}

QHeaderView::section:hover {
    background-color: #353535;
}

QTableView {
    gridline-color: #454545;
}

/* Scroll bars ------------------------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #5a5a5a;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7a7a7a;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #5a5a5a;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7a7a7a;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

/* Tabs and groups (settings) --------------------------------------------------------------- */

QTabWidget::pane {
    background-color: #2d2d2d;
    border: 1px solid #454545;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #c8c8c8;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #ffffff;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #4ca2ff;
}

QGroupBox {
    background-color: #333333;
    border: 1px solid #454545;
    border-radius: 6px;
    margin-top: 18px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #c8c8c8;
    background: transparent;
}

QGroupBox QWidget {
    background-color: transparent;
}

QGroupBox QLineEdit, QGroupBox QSpinBox, QGroupBox QDoubleSpinBox {
    background-color: #252525;
}

QGroupBox QPushButton, QGroupBox QComboBox {
    background-color: #393939;
}

QScrollArea {
    border: none;
}

QSplitter::handle {
    background-color: #454545;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #454545;
}

/* Status bar (Ryujinx: refresh, game count and play time on the left, firmware on the right;
 * in game, docked mode, volume and controls, then the frame stats) ------------------------- */

QStatusBar {
    background-color: #2c2c2c;
    border-top: 1px solid #202020;
    color: #ffffff;
    min-height: 28px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background: transparent;
    padding: 0 6px;
}

QStatusBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px 8px;
    color: #ffffff;
}

QStatusBar QPushButton:hover {
    background-color: #3d3d3d;
}

QStatusBar QPushButton:checked {
    background: transparent;
    border: none;
}

QStatusBar QPushButton:checked:hover {
    background-color: #3d3d3d;
}

QPushButton#TogglableStatusBarButton:checked, QPushButton#DockingStatusBarButton:checked {
    color: #ffffff;
}

QPushButton#TogglableStatusBarButton:!checked, QPushButton#DockingStatusBarButton:!checked {
    color: #9a9a9a;
}

QPushButton#ControlsStatusBarButton {
    color: #4ca2ff;
}

QLabel#FirmwareLabel {
    color: #ffffff;
}

/* Dialogs ------------------------------------------------------------------------------------ */

QDialogButtonBox QPushButton {
    min-width: 72px;
}

QListWidget {
    background-color: #2b2b2b;
    border: 1px solid #454545;
    border-radius: 6px;
}

QListWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #3d3d3d;
    color: #ffffff;
}
